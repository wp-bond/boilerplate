{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "APP_ENV=production vite build",
    "dev-admin": "vite --config vite.config.wp-admin.js",
    "build-admin": "APP_ENV=production vite build --config vite.config.wp-admin.js",
    "build-editor": "vite build --config vite.config.wp-editor.js",
    "build-watch-editor": "vite build --config vite.config.wp-editor.js --watch",
    "build-all": "pnpm build && pnpm build-admin && pnpm build-editor",
    "upgrade": "pnpm dlx npm-check-updates -u && pnpm install"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lodash-es": "^4.17.21",
    "ohmyfetch": "^0.4.21",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.17.0",
    "@csstools/postcss-global-data": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "eslint": "^9.31.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-preset-env": "^10.2.4",
    "stylelint": "^16.22.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-live-reload": "^3.0.5"
  }
}
